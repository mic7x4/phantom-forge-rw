# PostgreSQL connection string.
# Works with Supabase, Neon, or a self-hosted PostgreSQL server.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Admin dashboard authentication.
# Use a long random value (32+ characters) for SESSION_SECRET.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Payment provider credentials will be added server-side later.
# Never put payment secrets in VITE_* variables or client-side code.
